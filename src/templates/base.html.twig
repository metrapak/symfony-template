<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        {# FR-071/FR-072: the viewer's brand colours, before any page stylesheet, so a layout
           can override them and a component can only read them. #}
        {{ include('_branding.html.twig') }}

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {# FR-029: above all content, on every page that uses this layout. #}
        {{ include('_impersonation_banner.html.twig') }}
        <img src="{{ asset('main/images/red-pin.svg') }}" alt="Red pin">
        {% block body %}{% endblock %}
    </body>
</html>
