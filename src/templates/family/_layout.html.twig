{#
    Shell for the family section (FR-066, FR-069).

    The same application shell as `account/_layout.html.twig` — sidebar of destinations, topbar,
    dark canvas with the accent wash (designs/event_builder.svg) — with a parent's navigation in
    it. The section used to carry its own light-canvas `<style>` block; that block is gone and
    the class vocabulary its pages already use (`card`, `muted`, `actions`, `warning`, a plain
    `<table>`) is repainted by the theme instead, so moving the section across changed no content
    template.

    Carries the context switcher, because FR-069 calls it "a navigation control" and this is the
    navigation.

    The approvals count is rendered here rather than by `nav.item`, because the item needs a
    badge the macro does not draw. The number is `aria-hidden` and spelled out beside it, so it
    is never the only way to know how many are waiting.
#}
{% extends 'base.html.twig' %}

{% block body_class %}pp-theme{% endblock %}

{% block body %}
    {% import '_nav.html.twig' as nav %}
    {% import '_icons.html.twig' as icons %}

    {% set branding = viewer_branding() %}
    {% set logoUrl = branding_logo_url(branding) %}
    {% set route = app.request.attributes.get('_route') %}

    <div class="pp-shell">
        <div class="pp-sidebar">
            <a class="pp-brand" href="{{ path('family_dashboard') }}">
                <span class="pp-brand-mark">
                    {% if logoUrl %}
                        {# `alt=""`: the organization's name is written out immediately beside it. #}
                        <img src="{{ logoUrl }}" alt="">
                    {% else %}
                        {{ include('_logo.html.twig') }}
                    {% endif %}
                </span>
                <span>{{ branding.organizationName ?? app_name }}</span>
            </a>

            <nav class="pp-nav" aria-label="Family sections">
                <ul>
                    {{ nav.item(path('family_dashboard'), 'Dashboard', 'dashboard', route == 'family_dashboard') }}
                    {{ nav.item(path('family_index'), 'Player profiles', 'family', route starts with 'family_' and route not in ['family_dashboard', 'family_approvals', 'family_approval_show']) }}
                    {{ nav.item(path('availability_index'), 'Best Times', 'calendar', route starts with 'availability_') }}

                    <li>
                        <a class="pp-nav-item" href="{{ path('family_approvals') }}"
                           {% if route starts with 'family_approval' %}aria-current="page"{% endif %}>
                            {{ icons.icon('approvals') }}
                            <span>Approvals</span>
                            {% set waiting = pending_approval_count() %}
                            {% if waiting > 0 %}
                                <span class="badge" aria-hidden="true">{{ waiting }}</span>
                                <span class="visually-hidden">— {{ waiting }} waiting for you</span>
                            {% endif %}
                        </a>
                    </li>

                    {{ nav.item(path('player_reservations'), 'Reservations', 'reservations', route == 'player_reservations') }}

                    {# FR-093. The count and its screen-reader wording live in the shared partial,
                       which four other shells also include, so the item is assembled here. #}
                    <li class="pp-nav-item pp-nav-item--wrap">
                        {{ icons.icon('notifications') }}
                        {{ include('_notification_indicator.html.twig') }}
                    </li>

                    {{ nav.item(path('account_profile'), 'My profile', 'profile', route == 'account_profile') }}
                    {{ nav.item(logout_path(), 'Sign out', 'signout', false) }}
                </ul>
            </nav>
        </div>

        <main id="main-content" class="pp-main">
            <div class="pp-topbar">
                <h1 class="pp-page-title">{% block heading %}{% endblock %}</h1>

                {# The initials are decoration: the name they abbreviate is in the same link. #}
                <a class="pp-user-chip" href="{{ path('account_profile') }}">
                    <span class="pp-avatar" aria-hidden="true">{{ app.user.displayName|slice(0, 2) }}</span>
                    <span>{{ app.user.displayName }}</span>
                </a>
            </div>

            {{ include('_context_switcher.html.twig') }}

            {# Flash messages announce themselves without stealing focus. #}
            <div role="status" aria-live="polite">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <p class="flash flash-{{ label }}">{{ message }}</p>
                    {% endfor %}
                {% endfor %}
            </div>

            <div class="pp-content">
                {% block family_content %}{% endblock %}
            </div>
        </main>
    </div>
{% endblock %}
