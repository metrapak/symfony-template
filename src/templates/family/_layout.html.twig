{#
    Shell for the family section (FR-066, FR-069).

    Carries the context switcher, because FR-069 calls it "a navigation control" and this is the
    navigation. Plain CSS in the layout, like the trainer and admin shells: this epic ships
    behaviour, and the brand colour arrives through the `--brand` custom property that
    `_branding.html.twig` sets, so a trainer's colour reaches these pages with nothing here
    knowing whose colour it is.

    Responsive without a framework: the family table reflows at narrow widths by turning each row
    into a stacked block (NFR-X05 asks for 320px), and every control is at least 2.75rem tall so
    it is a comfortable touch target.
#}
{% extends 'base.html.twig' %}

{% block body %}
    <main id="main-content" class="family">
        <nav aria-label="Family sections">
            <ul class="family-nav">
                <li><a href="{{ path('family_dashboard') }}">Dashboard</a></li>
                <li><a href="{{ path('family_index') }}">Player profiles</a></li>
                <li><a href="{{ path('account_profile') }}">My profile</a></li>
                <li><a href="{{ logout_path() }}">Sign out</a></li>
            </ul>
        </nav>

        {{ include('_context_switcher.html.twig') }}

        {# Flash messages announce themselves without stealing focus. #}
        <div role="status" aria-live="polite">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <p class="flash flash-{{ label }}">{{ message }}</p>
                {% endfor %}
            {% endfor %}
        </div>

        <h1>{% block heading %}{% endblock %}</h1>

        {% block family_content %}{% endblock %}
    </main>

    <style>
        .family { max-width: 72rem; margin: 0 auto; padding: 1rem; font: 400 1rem/1.5 system-ui, sans-serif; }
        .family-nav { display: flex; flex-wrap: wrap; gap: 1rem; list-style: none; padding: 0; }
        .family h1, .family h2 { color: var(--brand); }
        .family table { width: 100%; border-collapse: collapse; }
        .family th, .family td { padding: .5rem; border-bottom: 1px solid #d4d4d4; text-align: left; vertical-align: top; }
        .family th { background: #f5f5f5; }
        .family .flash-error { color: #b91c1c; }
        .family .flash-warning { color: #b45309; }
        .family .actions { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; }
        .family :focus-visible { outline: 3px solid var(--brand); outline-offset: 2px; }
        .family button, .family input, .family select { min-height: 2.75rem; }
        .family .avatar { width: 3rem; height: 3rem; border-radius: 50%; object-fit: cover; }
        .family .muted { color: #525252; }
        .family .warning { border-left: 4px solid #b45309; padding: .5rem .75rem; background: #fffbeb; }
        .family .card { border: 1px solid #d4d4d4; border-radius: .5rem; padding: 1rem; margin-bottom: 1rem; }
        .context-switcher { margin: 1rem 0; padding: .75rem; border: 1px solid #d4d4d4; border-radius: .5rem; }
        .context-switcher form { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
        .form-error-summary { border-left: 4px solid #b91c1c; padding: .5rem .75rem; background: #fef2f2; }
        .visually-hidden {
            position: absolute;
            width: 1px; height: 1px;
            margin: -1px; padding: 0; border: 0;
            clip-path: inset(50%);
            overflow: hidden;
            white-space: nowrap;
        }

        /* The family table reflows rather than scrolling: at 320px each row becomes a labelled
           block, so nothing is reachable only by horizontal scrolling. */
        @media (max-width: 40rem) {
            .family table, .family tbody, .family tr, .family td { display: block; width: 100%; }
            .family thead { display: none; }
            .family tr { border: 1px solid #d4d4d4; border-radius: .5rem; margin-bottom: 1rem; padding: .5rem; }
            .family td { border: 0; padding: .25rem .5rem; }
            .family td::before { content: attr(data-label) ": "; font-weight: 600; }
            .family td.no-label::before { content: ""; }
        }
    </style>
{% endblock %}
