{# FR-042 — the confirmation a new player or parent receives. #}
<p>Hello {{ name }},</p>

<p>
    {% if playerName == name %}
        You are registered with <strong>{{ organizationName }}</strong>.
    {% else %}
        <strong>{{ playerName }}</strong> is registered with <strong>{{ organizationName }}</strong>.
    {% endif %}
</p>

{% if verificationRequired %}
    <p>
        One more step: we have sent a second email with a confirmation link. Open it to activate
        your sign-in — you will not be able to sign in until you do.
    </p>
{% else %}
    <p>You can sign in and see this trainer's events and content straight away.</p>
{% endif %}

<p>
    Your details are visible to {{ organizationName }} only. If you later join another trainer,
    each trainer sees their own program and nothing else.
</p>
