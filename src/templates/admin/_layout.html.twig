{#
    Shell for the Super Admin tools.

    The same application shell as every other signed-in section (designs/event_builder.svg). It
    is the one shell whose accent is *not* a trainer's: a Super Admin has no organization, so
    `viewer_branding()` returns the platform default and the theme's own green is what shows —
    which is the honest signal that these pages are above any single tenant.

    The section's old light-canvas `<style>` block is gone; the class vocabulary its pages use
    (`filters`, `actions`, `status-*`, a plain `<table>`, the confirm `<dialog>`) is repainted in
    `assets/styles/app.css`.
#}
{% extends 'base.html.twig' %}

{% block body_class %}pp-theme{% endblock %}

{% block body %}
    {% import '_nav.html.twig' as nav %}

    {% set route = app.request.attributes.get('_route') %}

    <div class="pp-shell">
        <div class="pp-sidebar">
            <a class="pp-brand" href="{{ path('admin_dashboard') }}">
                <span class="pp-brand-mark">{{ include('_logo.html.twig') }}</span>
                <span>{{ app_name }}</span>
            </a>

            <nav class="pp-nav" aria-label="Admin sections">
                <ul>
                    {{ nav.item(path('admin_dashboard'), 'Dashboard', 'dashboard', route == 'admin_dashboard') }}
                    {{ nav.item(path('admin_users_index'), 'Users', 'family', route starts with 'admin_users_') }}
                    {{ nav.item(path('admin_audit_impersonations'), 'Impersonation history', 'admin', route == 'admin_audit_impersonations') }}
                    {{ nav.item(logout_path(), 'Sign out', 'signout', false) }}
                </ul>
            </nav>
        </div>

        <main id="main-content" class="pp-main">
            <div class="pp-topbar">
                <h1 class="pp-page-title">{% block heading %}{% endblock %}</h1>

                <a class="pp-user-chip" href="{{ path('account_profile') }}">
                    <span class="pp-avatar" aria-hidden="true">{{ app.user.displayName|slice(0, 2) }}</span>
                    <span>{{ app.user.displayName }}</span>
                </a>
            </div>

            {# Announced without stealing focus, matching the account layout. #}
            <div role="status" aria-live="polite">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <p class="flash flash-{{ label }}">{{ message }}</p>
                    {% endfor %}
                {% endfor %}
            </div>

            <div class="pp-content">
                {% block admin_content %}{% endblock %}
            </div>
        </main>
    </div>
{% endblock %}
