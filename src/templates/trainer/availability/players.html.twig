{#
    Player availability, and the filter over it (FR-083, FR-084, BR-082, BR-087).

    Read-only by construction: there is no form here that writes anything, and the rows are read
    models rather than profiles. BR-082 says a trainer views availability and never edits it, and
    a trainer who goes looking for a player's own grid gets a 403 from the voter.

    The three-way count is the honest version of the spec's "15 out of 20". A player who has never
    filled the grid in is neither available nor unavailable, and reporting them as busy would tell
    a trainer something nobody said — so the undeclared count is printed beside the headline
    number rather than folded into it.
#}
{% extends 'trainer/_layout.html.twig' %}
{% form_theme form 'account/_form_theme.html.twig' %}

{% block title %}Player availability{% endblock %}
{% block heading %}Player availability{% endblock %}

{% block trainer_content %}
    <p class="muted">
        Best Times are a planning aid. Nothing here prevents you scheduling a session at any time
        you like. {{ grid.timezoneNotice }}
    </p>

    <form method="get" action="{{ path('trainer_players_availability') }}" class="card">
        {# GET, and no CSRF token: this reads and changes nothing, and a filtered roster should be
           a URL a trainer can send to a colleague. #}
        {{ include('account/_error_summary.html.twig', {form: form}) }}

        <fieldset>
            <legend>Show players available on…</legend>
            <div class="actions">
                {{ form_row(form.day) }}
                {{ form_row(form.startMinute) }}
                {{ form_row(form.endMinute) }}
                <button type="submit">Filter</button>
                {% if filterApplied %}
                    <a href="{{ path('trainer_players_availability') }}">Clear filter</a>
                {% endif %}
            </div>
        </fieldset>
        {{ form_rest(form) }}
    </form>

    {% if filterApplied and tally is not null %}
        <p class="tally" role="status">
            <strong>Players available at this time: {{ tally.summary }}</strong>
            ({{ filterDay.label }} {{ filterWindow.format }}).
            {% if tally.undeclared > 0 %}
                {{ tally.undeclared }} {{ tally.undeclared == 1 ? 'player has' : 'players have' }} not set their times yet.
            {% endif %}
        </p>
    {% endif %}

    <table>
        <caption class="visually-hidden">
            {{ filterApplied ? 'Players, with those available in the filtered window marked' : 'Players and their preferred training times' }}
        </caption>
        <thead>
            <tr>
                <th scope="col">Player</th>
                <th scope="col">Best Times</th>
                {% if filterApplied %}<th scope="col">Available then?</th>{% endif %}
            </tr>
        </thead>
        <tbody>
        {% for player in players %}
            <tr>
                <th scope="row">{{ player.playerName }}</th>
                <td class="{{ player.hasDeclared ? '' : 'muted' }}">{{ player.summary }}</td>
                {% if filterApplied %}
                    {# The answer is a word, never a colour on its own (NFR-X04). #}
                    <td>
                        {% if player.matchesFilter %}
                            Yes
                        {% elseif player.hasDeclared %}
                            No
                        {% else %}
                            Not set
                        {% endif %}
                    </td>
                {% endif %}
            </tr>
        {% else %}
            <tr>
                <td colspan="{{ filterApplied ? 3 : 2 }}">
                    No players yet. Share a player link to bring your first players in.
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
