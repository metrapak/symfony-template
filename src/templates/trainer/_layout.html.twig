{#
    Shell for the trainer tools.

    The same application shell as every other signed-in section (designs/event_builder.svg). The
    trainer's own colour reaches these pages through the `--brand` custom property that
    `_branding.html.twig` sets (US-01.14); the theme derives its whole accent scale from it, so a
    trainer's branding now colours the sidebar, the buttons and the focus ring rather than only a
    heading. The section's old light-canvas `<style>` block is gone.
#}
{% extends 'base.html.twig' %}

{% block body_class %}pp-theme{% endblock %}

{% block body %}
    {% import '_nav.html.twig' as nav %}

    {% set branding = viewer_branding() %}
    {% set logoUrl = branding_logo_url(branding) %}
    {% set route = app.request.attributes.get('_route') %}

    <div class="pp-shell">
        <div class="pp-sidebar">
            <a class="pp-brand" href="{{ path('trainer_dashboard') }}">
                <span class="pp-brand-mark">
                    {% if logoUrl %}
                        <img src="{{ logoUrl }}" alt="">
                    {% else %}
                        {{ include('_logo.html.twig') }}
                    {% endif %}
                </span>
                <span>{{ branding.organizationName ?? app_name }}</span>
            </a>

            <nav class="pp-nav" aria-label="Trainer sections">
                <ul>
                    {{ nav.item(path('trainer_dashboard'), 'Dashboard', 'dashboard', route == 'trainer_dashboard') }}
                    {{ nav.item(path('trainer_share_links_index'), 'Player links', 'mail', route starts with 'trainer_share_links_') }}
                    {{ nav.item(path('trainer_coaches_index'), 'Coaches', 'family', route starts with 'trainer_coach') }}
                    {{ nav.item(path('trainer_players_availability'), 'Player availability', 'availability', route == 'trainer_players_availability') }}
                    {{ nav.item(path('trainer_branding'), 'Branding', 'check', route == 'trainer_branding') }}
                    {{ nav.item(path('account_profile'), 'My profile', 'profile', route == 'account_profile') }}
                    {{ nav.item(logout_path(), 'Sign out', 'signout', false) }}
                </ul>
            </nav>
        </div>

        <main id="main-content" class="pp-main">
            <div class="pp-topbar">
                <h1 class="pp-page-title">{% block heading %}{% endblock %}</h1>

                <a class="pp-user-chip" href="{{ path('account_profile') }}">
                    <span class="pp-avatar" aria-hidden="true">{{ app.user.displayName|slice(0, 2) }}</span>
                    <span>{{ app.user.displayName }}</span>
                </a>
            </div>

            <div role="status" aria-live="polite">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <p class="flash flash-{{ label }}">{{ message }}</p>
                    {% endfor %}
                {% endfor %}
            </div>

            <div class="pp-content">
                {% block trainer_content %}{% endblock %}
            </div>
        </main>
    </div>
{% endblock %}
