{#
    Shell for the coach's own pages (US-01.10).

    The first one the coach role has: TASK-001 gave every role a placeholder dashboard, and until
    now a coach had nothing of their own to navigate. It uses the same application shell as every
    other signed-in section (designs/event_builder.svg) — the section's old light-canvas `<style>`
    block is gone, and the class vocabulary its pages already use is repainted by the theme.
#}
{% extends 'base.html.twig' %}

{% block body_class %}pp-theme{% endblock %}

{% block body %}
    {% import '_nav.html.twig' as nav %}

    {% set branding = viewer_branding() %}
    {% set logoUrl = branding_logo_url(branding) %}
    {% set route = app.request.attributes.get('_route') %}

    <div class="pp-shell">
        <div class="pp-sidebar">
            <a class="pp-brand" href="{{ path('coach_dashboard') }}">
                <span class="pp-brand-mark">
                    {% if logoUrl %}
                        <img src="{{ logoUrl }}" alt="">
                    {% else %}
                        {{ include('_logo.html.twig') }}
                    {% endif %}
                </span>
                <span>{{ branding.organizationName ?? app_name }}</span>
            </a>

            <nav class="pp-nav" aria-label="Coach sections">
                <ul>
                    {{ nav.item(path('coach_dashboard'), 'Dashboard', 'dashboard', route == 'coach_dashboard') }}
                    {{ nav.item(path('coach_my_times'), 'My Times', 'clock', route == 'coach_my_times') }}
                    {{ nav.item(path('account_profile'), 'My profile', 'profile', route == 'account_profile') }}
                    {{ nav.item(logout_path(), 'Sign out', 'signout', false) }}
                </ul>
            </nav>
        </div>

        <main id="main-content" class="pp-main">
            <div class="pp-topbar">
                <h1 class="pp-page-title">{% block heading %}{% endblock %}</h1>

                <a class="pp-user-chip" href="{{ path('account_profile') }}">
                    <span class="pp-avatar" aria-hidden="true">{{ app.user.displayName|slice(0, 2) }}</span>
                    <span>{{ app.user.displayName }}</span>
                </a>
            </div>

            <div role="status" aria-live="polite">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <p class="flash flash-{{ label }}">{{ message }}</p>
                    {% endfor %}
                {% endfor %}
            </div>

            <div class="pp-content">
                {% block coach_content %}{% endblock %}
            </div>
        </main>
    </div>
{% endblock %}
