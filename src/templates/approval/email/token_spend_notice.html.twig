{#
    FR-092 — the parent waived approval for this child's tokens, so this is news and not a
    request. The first line says so, because a parent who receives both kinds must be able to tell
    them apart without opening either.
#}
{% extends 'email/_layout.html.twig' %}

{% block email_title %}{{ childName }} spent tokens{% endblock %}
{% block preheader %}For your information — there is nothing for you to approve.{% endblock %}

{% block email_content %}
    <p style="margin:0 0 14px 0;">Hello {{ recipientName }},</p>

    <p style="margin:0 0 14px 0;">This is for your information — there is nothing for you to approve.</p>

    <p style="margin:0 0 14px 0;">
        <strong>{{ childName }}</strong> bought <strong>{{ purchaseDescription }}</strong> for
        <strong>{{ amount }}</strong> using tokens. You allow this child to spend tokens without
        approval, so they were registered straight away.
    </p>

    {{ include('email/_button.html.twig', {
        url: settingsUrl,
        label: 'Change what ' ~ childName ~ ' may spend without asking',
        brand: brandColor|default('#006600'),
    }) }}
{% endblock %}
