{#
    FR-093 — the parent is asked to decide.

    Carries the four facts the requirement names — which child, which purchase, how much, and how
    it would be paid — so a parent reading this on a phone knows what they are being asked before
    they sign in. The deadline is here too, because FR-096 makes silence an answer.
#}
{% extends 'email/_layout.html.twig' %}

{% block email_title %}A purchase needs your approval{% endblock %}
{% block preheader %}{{ childName }} would like to buy {{ purchaseDescription }} for {{ amount }}.{% endblock %}

{% block email_content %}
    <p style="margin:0 0 14px 0;">Hello {{ recipientName }},</p>

    <p style="margin:0 0 14px 0;">
        <strong>{{ childName }}</strong> would like to buy <strong>{{ purchaseDescription }}</strong>
        for <strong>{{ amount }}</strong>, paid with {{ paymentType|lower }}.
    </p>

    {{ include('email/_button.html.twig', {
        url: reviewUrl,
        label: 'Approve or deny this purchase',
        brand: brandColor|default('#006600'),
    }) }}

    {% if expiresAt %}
        <p style="margin:0 0 14px 0;">
            If nobody answers by <strong>{{ expiresAt|date('j M Y, H:i') }}</strong> the request is
            denied automatically and nothing is charged.
        </p>
    {% endif %}

    <p style="margin:0;">Nothing has been paid for yet.</p>
{% endblock %}
