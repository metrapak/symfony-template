{# FR-095 — denied, and nothing was charged. Said plainly, because that is the part that matters. #}
{% extends 'email/_layout.html.twig' %}

{% block email_title %}Purchase not approved{% endblock %}
{% block preheader %}{{ purchaseDescription }} for {{ childName }} was not approved. Nothing has been charged.{% endblock %}

{% block email_content %}
    <p style="margin:0 0 14px 0;">Hello {{ recipientName }},</p>

    <p style="margin:0 0 14px 0;">
        <strong>{{ purchaseDescription }}</strong> for <strong>{{ childName }}</strong> was not
        approved. Nothing has been charged.
    </p>

    {% if parentNotes %}
        <p style="margin:0;"><strong>Note:</strong> {{ parentNotes }}</p>
    {% endif %}
{% endblock %}
