{% extends 'email/_layout.html.twig' %}

{% block email_title %}Confirm your email address{% endblock %}
{% block preheader %}Confirm your address to finish setting up your account.{% endblock %}

{% block email_content %}
    <p style="margin:0 0 14px 0;">Hello,</p>

    <p style="margin:0 0 14px 0;">Please confirm your email address so you can start using your account.</p>

    {{ include('email/_button.html.twig', {
        url: verificationUrl,
        label: 'Confirm my email address',
        brand: brandColor|default('#006600'),
    }) }}

    <p style="margin:0;">The link stops working on {{ expiresAt|date('j F Y \\a\\t H:i') }} (UTC).</p>
{% endblock %}
