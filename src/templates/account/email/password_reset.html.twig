{% extends 'email/_layout.html.twig' %}

{% block email_title %}Reset your password{% endblock %}
{% block preheader %}Use the link inside to choose a new password. It lasts {{ expiresInMinutes }} minutes.{% endblock %}

{% block email_content %}
    <p style="margin:0 0 14px 0;">Hello,</p>

    <p style="margin:0 0 14px 0;">
        Someone asked to reset the password for your account. If that was you, use the link
        below to choose a new one.
    </p>

    {{ include('email/_button.html.twig', {
        url: resetUrl,
        label: 'Set a new password',
        brand: brandColor|default('#006600'),
    }) }}

    <p style="margin:0 0 14px 0;">The link stops working in {{ expiresInMinutes }} minutes and can only be used once.</p>

    <p style="margin:0;">If you did not ask for this, you can ignore this message — your password has not changed.</p>
{% endblock %}
