{#
    Request a password reset (FR-004).

    The response to this form is identical whether or not the address is known — the functional
    suite compares the two rendered bodies byte for byte — so nothing here may echo the submitted
    address or vary on whether a user was found.
#}
{% extends 'account/_focus_layout.html.twig' %}
{% form_theme form 'account/_form_theme.html.twig' %}

{% block title %}Reset your password{% endblock %}
{% block heading %}Reset your password{% endblock %}

{% block lead %}
    <p class="pp-auth-lead">
        Enter the email address for your account and we will send you a link to set a new
        password. The link is good for one hour and can be used once.
    </p>
{% endblock %}

{% block account_content %}
    {{ include('account/_error_summary.html.twig') }}

    {{ form_start(form, {attr: {class: 'pp-form'}}) }}
        {{ form_row(form.email) }}
        <button type="submit" class="pp-btn pp-btn--primary pp-btn--block">Send reset link</button>
    {{ form_end(form) }}

    <ul class="pp-auth-links">
        <li><a href="{{ path('app_login') }}">Back to sign in</a></li>
    </ul>
{% endblock %}
