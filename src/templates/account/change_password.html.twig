{% extends 'account/_layout.html.twig' %}
{% form_theme form 'account/_form_theme.html.twig' %}

{% block title %}Change your password{% endblock %}
{% block heading %}Change your password{% endblock %}

{% block account_content %}
    {% if forced %}
        <p role="alert">
            Your account was created with a temporary password. Choose your own password to continue.
        </p>
    {% endif %}

    {{ include('account/_error_summary.html.twig') }}

    {{ form_start(form) }}
        {{ form_row(form.currentPassword) }}
        {{ form_row(form.plainPassword.first) }}
        {{ form_row(form.plainPassword.second) }}
        <button type="submit">Save new password</button>
    {{ form_end(form) }}

    <p><a href="{{ logout_path() }}">Sign out</a></p>
{% endblock %}
