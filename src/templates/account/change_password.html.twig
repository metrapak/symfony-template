{#
    Voluntary and forced password change (FR-006).

    Uses the focused layout rather than the application shell on purpose. While
    `must_change_password` is set, `PasswordChangeGuard` redirects every other route back here, so
    a sidebar would be a list of links that all bounce straight to this page. The only other way
    out is signing out, and that is the one link offered.

    When the change is *not* forced the page is reached from the shell's navigation, so it offers
    a way back to the dashboard as well.
#}
{% extends 'account/_focus_layout.html.twig' %}
{% form_theme form 'account/_form_theme.html.twig' %}

{% block title %}Change your password{% endblock %}
{% block heading %}Change your password{% endblock %}

{% block account_content %}
    {% if forced %}
        {#
            `role="alert"` because this is the reason the user is on a page they did not ask for.
            It is a statement of the account's state, not an error, so it is a notice rather than
            the error summary.
        #}
        <p class="pp-notice" role="alert">
            Your account was created with a temporary password. Choose your own password to
            continue.
        </p>
    {% endif %}

    {{ include('account/_error_summary.html.twig') }}

    {{ form_start(form, {attr: {class: 'pp-form'}}) }}
        {{ form_row(form.currentPassword) }}
        {#
            `help: null` suppresses the form type's one-line summary of the same rules. The
            checklist below says everything it said and also says which parts are already
            satisfied; keeping both would state the requirements twice, once as prose and once as
            a list, and a screen reader would read both from the same `aria-describedby`.
        #}
        {{ form_row(form.plainPassword.first, {help: null, attr: {'aria-describedby': 'password-rules'}}) }}
        {{ include('account/_password_rules.html.twig', {field: form.plainPassword.first.vars.id}) }}
        {{ form_row(form.plainPassword.second) }}
        <button type="submit" class="pp-btn pp-btn--primary pp-btn--block">Save new password</button>
    {{ form_end(form) }}

    <ul class="pp-auth-links">
        {% if not forced %}
            <li><a href="{{ path('account_dashboard') }}">Back to your dashboard</a></li>
        {% endif %}
        <li><a href="{{ logout_path() }}">Sign out</a></li>
    </ul>
{% endblock %}
