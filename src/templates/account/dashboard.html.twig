{% extends 'account/_layout.html.twig' %}

{% block title %}{{ roleLabel }} dashboard{% endblock %}
{% block heading %}{{ roleLabel }} dashboard{% endblock %}

{% block account_content %}
    {# Placeholder. Each role's real dashboard content arrives with its own feature task. #}
    <p>Signed in as {{ app.user.userIdentifier }}.</p>

    <ul>
        <li><a href="{{ path('account_profile') }}">Your profile</a></li>
        {# The family section is a player's own; a trainer, coach or admin has no children to
           manage and would only get a 403 from the voter guarding it. #}
        {% if is_granted('FAMILY_MANAGE_CHILDREN') %}
            <li><a href="{{ path('family_index') }}">Player profiles and family</a></li>
        {% endif %}
        <li><a href="{{ path('account_password_change') }}">Change your password</a></li>
        <li><a href="{{ logout_path() }}">Sign out</a></li>
    </ul>
{% endblock %}
