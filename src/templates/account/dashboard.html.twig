{% extends 'account/_layout.html.twig' %}

{% block title %}{{ roleLabel }} dashboard{% endblock %}
{% block heading %}{{ roleLabel }} dashboard{% endblock %}

{% block account_content %}
    {# Placeholder. Each role's real dashboard content arrives with its own feature task. #}
    <p>Signed in as {{ app.user.userIdentifier }}.</p>

    <ul>
        <li><a href="{{ path('account_profile') }}">Your profile</a></li>
        {# The family section is a player's own; a trainer, coach or admin has no children to
           manage and would only get a 403 from the voter guarding it. #}
        {% if is_granted('FAMILY_MANAGE_CHILDREN') %}
            <li><a href="{{ path('family_index') }}">Player profiles and family</a></li>
        {% endif %}
        {# FR-080 and FR-082 both say the grid is reached "from navigation". Each role reaches its
           own: a player (or a child login) sets Best Times, a coach sets My Times, and neither
           link is offered to somebody the route would refuse. #}
        {% if is_granted('ROLE_PLAYER') %}
            <li><a href="{{ path('availability_index') }}">Best Times (your availability)</a></li>
            {# FR-090/FR-095: where a player — a parent or a child login — sees the status of what
               they have bought or asked to buy. #}
            <li><a href="{{ path('player_reservations') }}">My reservations</a></li>
        {% endif %}
        {# FR-094: only a parent decides purchases; a child login is refused the route by
           ApprovalVoter, so it is not offered one. #}
        {% if is_granted('ACCOUNT_MANAGE_PAYMENT_METHODS') %}
            <li><a href="{{ path('family_approvals') }}">Purchase approvals</a></li>
        {% endif %}
        {# FR-093: the in-app half of the notification, reachable by everybody who can receive one. #}
        <li>{{ include('_notification_indicator.html.twig') }}</li>
        {% if is_granted('ROLE_COACH') %}
            <li><a href="{{ path('coach_my_times') }}">My Times (your availability)</a></li>
        {% endif %}
        {% if is_granted('ROLE_TRAINER') %}
            <li><a href="{{ path('trainer_players_availability') }}">Player availability</a></li>
        {% endif %}
        <li><a href="{{ path('account_password_change') }}">Change your password</a></li>
        <li><a href="{{ logout_path() }}">Sign out</a></li>
    </ul>
{% endblock %}
