{% extends 'videos/admin/base.html.twig' %}

{% block mainadmin %}
    <h2>Editing category</h2>

    <form action="#" method="POST">
        <input type="text" class="form-control is-invalid" id="validationServer01" placeholder="Category name"
               value="{{ category.name }}"
               required>
        <br>
            {{ render(controller('App\\Videos\\Controller\\AdminController::getCategoriesOptions', {'editedCategory': category})) }}
        <div class="invalid-feedback">
            Category already exists!
        </div>
        <button class="btn btn-primary mt-3" type="submit">Save</button>

    </form>
{% endblock %}

