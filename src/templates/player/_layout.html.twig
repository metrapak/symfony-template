{#
    Shell for the pages a *player* uses — including a child login (FR-090, FR-093, FR-095).

    Separate from `family/_layout.html.twig` on purpose. That shell's navigation is a parent's:
    player profiles, adding children, spending settings. A child login holds `ROLE_PLAYER` exactly
    like their parent and would reach every one of those links, and every one of them would answer
    403 (FR-068, `ChildActionVoter`). Offering somebody a menu of refusals is not navigation.

    So the links here are the ones both a parent and a child may actually follow, and the
    parent-only entries are behind the same capability check that guards the routes — the check is
    the route's, this only decides whether to draw the link.

    The application shell and its dark canvas come from the theme (designs/event_builder.svg); the
    section's old light-canvas `<style>` block is gone and the class vocabulary its pages already
    use is repainted in `assets/styles/app.css` instead.
#}
{% extends 'base.html.twig' %}

{% block body_class %}pp-theme{% endblock %}

{% block body %}
    {% import '_nav.html.twig' as nav %}
    {% import '_icons.html.twig' as icons %}

    {% set branding = viewer_branding() %}
    {% set logoUrl = branding_logo_url(branding) %}
    {% set route = app.request.attributes.get('_route') %}

    <div class="pp-shell">
        <div class="pp-sidebar">
            <a class="pp-brand" href="{{ path('account_dashboard') }}">
                <span class="pp-brand-mark">
                    {% if logoUrl %}
                        <img src="{{ logoUrl }}" alt="">
                    {% else %}
                        {{ include('_logo.html.twig') }}
                    {% endif %}
                </span>
                <span>{{ branding.organizationName ?? app_name }}</span>
            </a>

            <nav class="pp-nav" aria-label="Sections">
                <ul>
                    {{ nav.item(path('account_dashboard'), 'Dashboard', 'dashboard', route in ['account_dashboard', 'family_dashboard']) }}
                    {{ nav.item(path('player_reservations'), 'My reservations', 'reservations', route in ['player_reservations', 'player_checkout']) }}
                    {{ nav.item(path('availability_index'), 'Best Times', 'calendar', route starts with 'availability_') }}
                    {{ nav.item(path('account_profile'), 'My profile', 'profile', route == 'account_profile') }}

                    {# FR-093. Assembled here rather than by `nav.item` so the count and its
                       screen-reader wording stay in the one partial five shells share. #}
                    <li class="pp-nav-item pp-nav-item--wrap">
                        {{ icons.icon('notifications') }}
                        {{ include('_notification_indicator.html.twig') }}
                    </li>

                    {# FR-094: only a parent decides purchases. A child login is refused the route
                       by `ApprovalVoter`, so it is not offered one either. #}
                    {% if is_granted('ACCOUNT_MANAGE_PAYMENT_METHODS') %}
                        {{ nav.item(path('family_approvals'), 'Approvals', 'approvals', route starts with 'family_approval') }}
                    {% endif %}

                    {{ nav.item(logout_path(), 'Sign out', 'signout', false) }}
                </ul>
            </nav>
        </div>

        <main id="main-content" class="pp-main">
            <div class="pp-topbar">
                <h1 class="pp-page-title">{% block heading %}{% endblock %}</h1>

                <a class="pp-user-chip" href="{{ path('account_profile') }}">
                    <span class="pp-avatar" aria-hidden="true">{{ app.user.displayName|slice(0, 2) }}</span>
                    <span>{{ app.user.displayName }}</span>
                </a>
            </div>

            {{ include('_context_switcher.html.twig') }}

            {# Flash messages announce themselves without stealing focus. #}
            <div role="status" aria-live="polite">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <p class="flash flash-{{ label }}">{{ message }}</p>
                    {% endfor %}
                {% endfor %}
            </div>

            <div class="pp-content">
                {% block player_content %}{% endblock %}
            </div>
        </main>
    </div>
{% endblock %}
