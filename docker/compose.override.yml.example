services:
  nginx:
    ports:
      - "127.0.0.1:8080:80"
      - "127.0.0.1:22:22"
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf

  php-fpm:
    volumes:
      - ./php-fpm/assets/xdebug.ini:/usr/local/etc/php/conf.d/zz-xdebug.ini

  postgres:
    ports:
      - "127.0.0.1:5432:5432"

  mailer:
      image: axllent/mailpit
      networks:
          - net
      ports:
          - "1025:1025" # SMTP
          - "8025:8025" # Web UI
      environment:
          MP_SMTP_AUTH_ACCEPT_ANY: 1
          MP_SMTP_AUTH_ALLOW_INSECURE: 1